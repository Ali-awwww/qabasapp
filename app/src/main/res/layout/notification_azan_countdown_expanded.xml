<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/azan_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_azan_countdown_notification"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/azan_countdown_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="العداد اللحظي • صلاة الفجر"
            android:textColor="#00E5FF"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_azan_countdown_live_dot" />

        <TextView
            android:id="@+id/azan_countdown_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans-serif-medium"
            android:text="مباشر"
            android:textColor="#10B981"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/azan_countdown_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="05:12 • 📍 دمشق"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_azan_countdown_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/azan_countdown_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="المتبقي حتى الأذان"
            android:textColor="#B8C3D1"
            android:textSize="11sp" />

        <Chronometer
            android:id="@+id/azan_countdown_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format="%s"
            android:gravity="center_vertical|end"
            android:text="09:55:42"
            android:textColor="#F8FAFC"
            android:textDirection="ltr"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/azan_countdown_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="9dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/progress_azan_countdown" />
</LinearLayout>
