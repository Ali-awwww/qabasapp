{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with league rewards, authentication identity and FCM tokens",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID of the user" },
        "has_reward": { "type": "boolean", "description": "Holds active league reward" },
        "reward_expiry": { "type": "string", "format": "date-time", "description": "Expiration time of reward" },
        "last_won_at": { "type": "string", "format": "date-time", "description": "Last time user won" },
        "total_wins": { "type": "integer", "description": "Total league wins" },
        "is_relative": { "type": "boolean", "description": "Free granted access flag" },
        "displayName": { "type": "string", "description": "Creator display name" },
        "email": { "type": "string", "description": "User email address" },
        "photoUrl": { "type": "string", "description": "Profile picture URL" },
        "fcmToken": { "type": "string", "description": "Cloud Messaging FCM registration token" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "createdAt"]
    },
    "SavedItem": {
      "title": "SavedItem",
      "description": "User saved Quran ayah, inspiration reflection, or dhikr with real-time sync and offline persistence",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the saved item" },
        "userId": { "type": "string", "description": "Auth UID of the owner" },
        "itemType": { "type": "string", "description": "Type: QURAN_AYAH, INSPIRATION, or DHIKR" },
        "title": { "type": "string", "description": "Title or reference heading" },
        "content": { "type": "string", "description": "Verse text or inspiration content" },
        "reference": { "type": "string", "description": "Surah/Ayah number or source reference" },
        "tags": { "type": "array", "description": "Tags associated with the saved item" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "itemType", "title", "content", "createdAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Weekly league leaderboard participant entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID" },
        "name": { "type": "string", "description": "Creator display name" },
        "points": { "type": "integer", "description": "Current points in weekly league" },
        "rank": { "type": "integer", "description": "Calculated position" },
        "views": { "type": "string", "description": "Display string for total views" },
        "badge": { "type": "string", "description": "Creator rank badge" },
        "is_eligible": { "type": "boolean", "description": "Participation eligibility" },
        "last_won_at": { "type": "string", "format": "date-time", "description": "Last win time" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "name", "points", "rank", "badge", "is_eligible"]
    },
    "SystemLeagueInfo": {
      "title": "SystemLeagueInfo",
      "description": "Global weekly league timing and status",
      "type": "object",
      "properties": {
        "end_date": { "type": "string", "format": "date-time", "description": "League round end date" },
        "round_number": { "type": "integer", "description": "Current league season/round number" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["end_date", "round_number"]
    },
    "Project": {
      "title": "Project",
      "description": "User created video or reel project",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "description": "Unique project identifier" },
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Project title" },
        "ai_script": { "type": "string", "description": "Generated or edited video script" },
        "has_voiceover": { "type": "boolean", "description": "Indicates audio/voiceover presence" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Project creation time" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last modification time" }
      },
      "required": ["projectId", "userId", "title", "createdAt", "updatedAt"]
    },
    "UpdateFailure": {
      "title": "UpdateFailure",
      "description": "Telemetry record of update or delta patching failure with stack trace and device metrics",
      "type": "object",
      "properties": {
        "failureId": { "type": "string", "description": "Unique identifier of the failure record" },
        "deviceId": { "type": "string", "description": "Unique device tracking identifier" },
        "userId": { "type": "string", "description": "User identifier if authenticated" },
        "currentVersionCode": { "type": "integer", "description": "Source/current version code on device" },
        "currentVersionName": { "type": "string", "description": "Source/current human readable version" },
        "targetVersionCode": { "type": "integer", "description": "Target version code attempting to apply" },
        "targetVersionName": { "type": "string", "description": "Target human readable version name" },
        "phase": { "type": "string", "description": "Lifecycle phase where failure occurred" },
        "errorMessage": { "type": "string", "description": "Processed clean error message from smart-exception" },
        "cleanStackTrace": { "type": "string", "description": "Sanitized stack trace produced by smart-exception" },
        "exceptionClass": { "type": "string", "description": "Canonical class name of root exception" },
        "deviceAbi": { "type": "string", "description": "Primary CPU architecture of the device" },
        "failureCount": { "type": "integer", "description": "Frequency count of failures for this device and target version" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Time when failure was first recorded" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Time when failure was last updated" }
      },
      "required": ["failureId", "deviceId", "currentVersionCode", "targetVersionCode", "phase", "errorMessage", "cleanStackTrace", "failureCount", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account documents keyed by Auth UID"
    },
    "/users/{userId}/saved_items/{itemId}": {
      "schema": "SavedItem",
      "description": "User saved Quran ayahs and spiritual inspirations"
    },
    "/leaderboard/{userId}": {
      "schema": "LeaderboardEntry",
      "description": "Public league rankings"
    },
    "/system/league_info": {
      "schema": "SystemLeagueInfo",
      "description": "Global league timer and season info"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User video projects"
    },
    "/update_failures/{failureId}": {
      "schema": "UpdateFailure",
      "description": "Failure telemetry records for OTA and delta updates"
    }
  }
}
